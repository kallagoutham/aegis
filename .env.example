# =====================================================================
# Aegis configuration
#
# Copy to .env.development (or .env.staging / .env.production) and edit.
# Files are searched in this order, first match wins:
#   .env.<APP_ENV>.local  ->  .env.<APP_ENV>  ->  .env.local  ->  .env
#
# Real environment variables always override anything in a file, so a
# container orchestrator or secret manager can inject values without
# rewriting the file.
#
# Every key here maps to a field in aegis/core/config.py. That module is
# the authoritative reference for defaults, bounds, and validation.
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_ENV=development
PROJECT_NAME="Aegis"
VERSION=1.0.0
DEBUG=true
API_V1_STR=/api/v1

# Comma-separated. '*' is rejected in staging and production, because it
# cannot be combined with credentialed requests.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# ---------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------
OPENAI_API_KEY="sk-your-key-here"

# Point at any OpenAI-compatible gateway (LiteLLM, vLLM, Azure proxy).
OPENAI_BASE_URL=https://api.openai.com/v1

DEFAULT_LLM_MODEL=gpt-4o-mini
# Tried in order when the primary model errors.
FALLBACK_LLM_MODELS="gpt-4o,gpt-4o-mini"
DEFAULT_LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4000
LLM_CONTEXT_TOKEN_BUDGET=32000
MAX_LLM_CALL_RETRIES=3
LLM_REQUEST_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------------
# Embeddings and retrieval
#
# EMBEDDING_DIMENSIONS must match the pgvector column width. Changing
# either the model or the dimension requires a migration and a full
# re-ingest with --force; existing vectors become meaningless otherwise.
# ---------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Chunks returned to the agent per search.
RETRIEVAL_TOP_K=8
# Candidates pulled from each arm before fusion. Higher = better recall,
# more work.
RETRIEVAL_CANDIDATE_K=40
RETRIEVAL_MIN_SCORE=0.0

# Weight of dense vector results during rank fusion; lexical gets 1 - this.
# Lower it toward 0.5 if your corpus is dense with exact error codes.
HYBRID_VECTOR_WEIGHT=0.7
RRF_K=60

# LLM cross-encoder rerank. Improves precision, costs one extra call
# per search. Disable for latency-critical deployments.
RERANK_ENABLED=true
RERANK_MODEL=gpt-4o-mini
RERANK_TOP_N=20

# ---------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=32
INGESTION_CONCURRENCY=4
MAX_UPLOAD_BYTES=26214400

# ---------------------------------------------------------------------
# Agent behaviour
# ---------------------------------------------------------------------
# Hard cap on investigate->tool loops before synthesis is forced.
AGENT_MAX_TOOL_ITERATIONS=6
AGENT_MAX_LOG_LINES=5000

LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_MODEL=gpt-4o-mini
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_COLLECTION_NAME=aegis_longterm_memory

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-this-password
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800
# Logs every statement. Never enable outside local debugging.
POSTGRES_ECHO=false

# ---------------------------------------------------------------------
# Authentication
#
# Generate a real secret:  openssl rand -hex 32
# Staging and production refuse to start with a short or placeholder value.
# ---------------------------------------------------------------------
JWT_SECRET_KEY="generate-me-with-openssl-rand-hex-32"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_SESSION_TOKEN_EXPIRE_MINUTES=10080
JWT_ISSUER=aegis
JWT_AUDIENCE=aegis-api
PASSWORD_MIN_LENGTH=12
# Cost factor. 12 is roughly 250ms per hash; tests drop to 4 automatically.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=console
LOG_DIR=logs
# Disable when the platform already captures stdout (Kubernetes, ECS).
LOG_TO_FILE=true
METRICS_ENABLED=true

# Langfuse tracing. Enables itself automatically when both keys are set.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------------------
# Rate limiting
#
# In-process, so limits are per replica. For strict global limits, point
# slowapi at Redis (see aegis/core/limiter.py).
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="30 per minute"
RATE_LIMIT_CHAT_STREAM="20 per minute"
RATE_LIMIT_MESSAGES="50 per minute"
# Investigations are expensive; keep this low.
RATE_LIMIT_INVESTIGATE="10 per minute"
RATE_LIMIT_INGEST="20 per hour"
RATE_LIMIT_SEARCH="60 per minute"
RATE_LIMIT_REGISTER="10 per hour"
RATE_LIMIT_LOGIN="20 per minute"

# ---------------------------------------------------------------------
# Evaluation harness
# ---------------------------------------------------------------------
# Judge model. Should be stronger than the model under test.
EVALUATION_LLM=gpt-4o
EVALUATION_BASE_URL=https://api.openai.com/v1
# Defaults to OPENAI_API_KEY when left empty.
EVALUATION_API_KEY=""
EVALUATION_SLEEP_TIME=10
